# ==== Entorno local (desarrollo) ====

# Conexión a la base de datos local (docker-compose). La API arranca con este valor
# cuando NO se usa Docker para el backend.
DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/projects_stacks

# Orígenes CORS permitidos, separados por coma (la SPA se sirve en http://localhost:8080)
CORS_ORIGINS=*

# ==== Credenciales de servicios (a futuro) ====
# Las completas el autor una vez creadas las cuentas en cada plataforma.
# Estas llaves se usan en el CI/CD y en el despliegue, NO se commitean.

# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# RENDER_API_KEY=
# VERCEL_TOKEN=